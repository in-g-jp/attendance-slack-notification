APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=intern_attendance_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google API Settings
GOOGLE_CLIENT_ID=あなたのWebアプリ用Client ID
GOOGLE_CLIENT_SECRET=あなたのWebアプリ用Client Secret
GOOGLE_REFRESH_TOKEN=先ほど取得した1//0...から始まるリフレッシュトークン
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# 出勤情報・予定一覧の通知でメンションするSlackメンバーID（例: U01ABCDE23）。
# 空欄にするとメンションなしで通知される。
SLACK_MENTION_USER_ID=

# Calendar factory settings
CALENDAR_USER_NAME=テストユーザー
CALENDAR_ID=test-user@example.com
CALENDAR_ROLE=インターン
CALENDAR_IS_ACTIVE=true

# Calendar seeder settings (multiple records)
# JSON array format. If this is set, it is prioritized over CALENDAR_*.
# CALENDAR_SEED_JSON='[{"user_name":"田中","calendar_id":"tanaka@example.com","role":"社員","is_active":true},{"user_name":"佐藤","calendar_id":"sato@example.com","role":"インターン","is_active":true}]'
